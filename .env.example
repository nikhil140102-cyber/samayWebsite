# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Database (MongoDB Atlas) — enables admin, newsletter, forms, orders ──
MONGODB_URI=

# ─── Admin auth — random string, 32+ characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=
# Owner login for /admin/login (works even before MongoDB is connected).
# Use a long password (12+ characters). More admins/editors: `npm run create-admin` (needs MongoDB).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── YouTube Data API v3 (optional — without it the public RSS feed is used)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCAov2BBv1ZJav0c_yHEciAw

# ─── Amazon Associates (India) ─────────────────────────────────────────
AMAZON_ASSOCIATE_TAG=
# AMAZON_DOMAIN=www.amazon.in

# ─── Razorpay (checkout stays disabled until both keys AND MongoDB are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe is not used — Razorpay covers Indian payments. STRIPE_SECRET_KEY is intentionally omitted.
